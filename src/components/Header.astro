---
import Icon from './Icon.astro';
import { SITE, NAV, waLink } from '../data/site';
import { PRODUCTS, colourNames } from '../data/products';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<a class="sr-only" href="#main">Skip to content</a>
<div class="topbar">
  <div class="container">
    <div class="topbar__links">
      <a href={`tel:${SITE.tel}`}><Icon name="phone" /> {SITE.phone}</a>
      <a class="hide-sm" href={`mailto:${SITE.email}`}><Icon name="mail" /> {SITE.email}</a>
    </div>
    <div class="topbar__note">Recycled <b>HDPE</b> · <b>PP</b> · <b>PPCP</b> · <b>LDPE</b> — prices on enquiry</div>
  </div>
</div>

<header class="header">
  <div class="container">
    <a class="logo" href="/" aria-label="Nityan Polymers — Home">
      <img src="/images/logo/logo-color.png" alt="Nityan Polymers" width="177" height="46" />
    </a>
    <nav class="nav" aria-label="Main">
      {NAV.map((item) =>
        item.href === '/products' ? (
          <div class="nav__item">
            <a class="nav__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label} <Icon name="chev" />
            </a>
            <div class="dropdown">
              {PRODUCTS.map((p) => (
                <a href={`/products/${p.slug}`}>
                  <span class="dot">{p.polymer}</span>
                  <span>{p.name}<small>{colourNames(p)}</small></span>
                </a>
              ))}
              <a href="/products/plastic-regrinds">
                <span class="dot" style="background:var(--yellow)">RG</span>
                <span>Plastic Regrinds<small>Enquire for availability</small></span>
              </a>
            </div>
          </div>
        ) : (
          <a class="nav__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        )
      )}
    </nav>
    <div class="header__cta">
      <a class="btn btn--wa btn--sm" href={waLink()} target="_blank" rel="noopener"><Icon name="wa" /> WhatsApp</a>
      <a class="btn btn--primary btn--sm" href="/contact#enquiry"><Icon name="quote" /> Request a Quote</a>
      <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" data-nav-open><span></span></button>
    </div>
  </div>
</header>

<div class="drawer">
  <div class="drawer__scrim" data-nav-close></div>
  <div class="drawer__panel" role="dialog" aria-label="Menu">
    <div class="drawer__top">
      <img src="/images/logo/logo-color.png" alt="Nityan Polymers" />
      <button class="drawer__close" type="button" aria-label="Close menu" data-nav-close>&times;</button>
    </div>
    {NAV.map((item) => (
      <>
        <a class="drawer__link" href={item.href}>{item.label}</a>
        {item.href === '/products' && (
          <div class="drawer__sub">
            {PRODUCTS.map((p) => <a href={`/products/${p.slug}`}>{p.name}</a>)}
            <a href="/products/plastic-regrinds">Plastic Regrinds</a>
          </div>
        )}
      </>
    ))}
    <a class="btn btn--primary" href="/contact#enquiry"><Icon name="quote" /> Request a Quote</a>
    <a class="btn btn--wa" href={waLink()} target="_blank" rel="noopener"><Icon name="wa" /> WhatsApp Us</a>
    <div class="drawer__contact">
      Talk to us
      <a href={`tel:${SITE.tel}`}><Icon name="phone" /> {SITE.phone}</a>
      <a href={`mailto:${SITE.email}`}><Icon name="mail" /> {SITE.email}</a>
    </div>
  </div>
</div>
