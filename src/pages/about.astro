---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
---
<BaseLayout
  title="About Us"
  description="Akshita Recycle is a polymer sourcing and material solutions company in Surat, India — sourcing, procurement and supply of recycled HDPE, PP, PPCP and LDPE for domestic and international buyers."
>
  <PageHero
    title="Connecting Polymer Markets. Enabling Circular Solutions."
    text="A reliable sourcing partner for recycled plastics and polymer materials across domestic and international markets."
    crumbs={[{ label: 'About Us' }]}
  >
    <ul class="hero-pills">
      <li>Domestic Sourcing</li>
      <li class="is-blue">Global Sourcing</li>
      <li>Recycled Materials</li>
    </ul>
  </PageHero>

  <section class="section">
    <div class="container split split--wide-text">
      <div class="reveal">
        <span class="eyebrow">Corporate introduction</span>
        <h2>A polymer <span class="hl">sourcing</span> &amp; material solutions company</h2>
        <p class="lead">Akshita Recycle is a polymer sourcing and material solutions company focused on sourcing, procurement and supply of recycled plastic materials.</p>
        <p>We connect suppliers, recyclers, processors and industrial buyers through reliable sourcing networks, quality-conscious material selection and professional trade coordination.</p>
        <p>Our business covers multiple polymer categories, serving domestic and international markets with a commitment to transparency, consistency and long-term partnerships.</p>
        <div class="btn-row" style="margin-top:26px">
          <a class="btn btn--dark" href="/products">View Products <Icon name="arrow" /></a>
          <a class="btn btn--primary" href="/contact#enquiry"><Icon name="quote" /> Request a Quote</a>
        </div>
      </div>
      <div class="media-stack reveal" data-delay="1">
        <Media slot="A1" label="About page main photo" img="/images/site/about-main.jpg" />
        <Media slot="A2" label="Secondary photo" img="/images/site/about-2.jpg" class="media--inset" />
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <h2 class="title-accent">Four polymers. One clear focus.</h2>
      </div>
      <div class="stat-row reveal">
        <div class="stat"><strong>HDPE</strong><span>Blue drum, pipe &amp; blow-grade granules, HDPE regrinds</span></div>
        <div class="stat"><strong>PP</strong><span>Injection-grade granules in natural, white &amp; black</span></div>
        <div class="stat"><strong>PPCP</strong><span>White granules, battery &amp; paint-bucket regrinds</span></div>
        <div class="stat"><strong>LDPE</strong><span>Film-grade granules for bags, liners &amp; non-food film</span></div>
      </div>
    </div>
  </section>

  <section class="split-panel">
    <div class="split-panel__media">
      <Media slot="A3" label="Material / warehouse photo" img="/images/site/home-about.jpg" />
    </div>
    <div class="split-panel__body reveal">
      <h2>Transparency. Consistency.<br />Long-term partnerships.</h2>
      <p>We connect suppliers, recyclers, processors and industrial buyers through reliable sourcing networks, quality-conscious material selection and professional trade coordination.</p>
      <p>Whether you buy in kilograms or full loads, for India or export, we keep material details, specifications and pricing clear from the first enquiry.</p>
      <a class="btn btn--light" href="/contact#enquiry">Talk to us <Icon name="chevr" /></a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <h2 class="title-accent">How we work with buyers</h2>
      </div>
      <div class="grid grid--3">
        <div class="feature reveal"><div class="feature__ico"><Icon name="target" mono /></div><h3>Start with the application</h3><p>Tell us what you're making, how you process it and what matters most — flow, strength, finish or colour.</p></div>
        <div class="feature reveal" data-delay="1"><div class="feature__ico"><Icon name="tag" mono /></div><h3>Prices on enquiry</h3><p>Quotations reflect the material and order requirements, so every buyer gets a price that fits their order.</p></div>
        <div class="feature reveal" data-delay="2"><div class="feature__ico"><Icon name="recycle" mono /></div><h3>Responsible claims</h3><p>Applications are indicative and confirmed through technical review and trial. Food-contact suitability is not claimed.</p></div>
      </div>
    </div>
  </section>

  <div class="spacer"></div>
  <CtaBand />
</BaseLayout>
