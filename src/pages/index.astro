---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { waLink, quoteLink } from '../data/site';
import { PRODUCTS, REGRINDS } from '../data/products';

// Home hero carousel photos (landscape, ~1600px wide). Add or reorder freely.
const HERO_SLIDES = [
  '/images/site/hero-pour.jpg',
  '/images/site/home-about.jpg',
  '/images/products/hdpe-blue-drum-granules.jpg',
  '/images/site/about-main.jpg',
  '/images/products/hdpe-pipe-grade-granules.jpg',
];

---
<BaseLayout
  title="Recycled Plastic Granules & Regrinds Supplier, Surat, India"
  description="Akshita Recycle, Surat (Gujarat, India) supplies recycled HDPE, PP, PPCP and LDPE granules and plastic regrinds to manufacturers in India and worldwide. Request a quote or WhatsApp us."
>
  <section class="vhero">
    <div class="vhero__slides" data-hero-carousel>
      {HERO_SLIDES.map((src, i) => (
        <img class:list={['vhero__bg', i === 0 && 'is-active']} src={src} alt="" width="1600" height="875"
          loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async" />
      ))}
    </div>
    <div class="vhero__dots" aria-label="Hero photos">
      {HERO_SLIDES.map((_, i) => (
        <button type="button" class:list={['vhero__dot', i === 0 && 'is-active']} aria-label={`Show photo ${i + 1}`} data-hero-dot={i}></button>
      ))}
    </div>
    <div class="container vhero__inner">
      <h1>Recycled Plastic Granules &amp; Regrinds for Manufacturers Worldwide</h1>
      <p class="vhero__lead">We connect recyclers, processors and industrial buyers, sourcing and supplying recycled HDPE, PP, PPCP and LDPE that matches your product, process and budget.</p>
      <p class="vhero__sub">Based in Surat, Gujarat, Akshita Recycle supplies manufacturers across India and export buyers, with specifications and samples shared with every offer.</p>
      <div class="btn-row btn-row--center">
        <a class="btn btn--primary" href="/contact#enquiry">Request a Quote <Icon name="chevr" /></a>
        <a class="btn btn--light" href="/products">View products <Icon name="chevr" /></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <h2 class="title-accent">What we do</h2>
        <p class="lead">A polymer sourcing and material solutions partner, from finding the right material to delivering it.</p>
      </div>
      <div class="vcards">
        <div class="vcard reveal"><span class="vcard__ico"><Icon name="search" /></span><h3>We source</h3><p>We source recycled plastic from trusted recyclers and processors, selecting material by grade, colour and application.</p></div>
        <div class="vcard reveal" data-delay="1"><span class="vcard__ico"><Icon name="network" /></span><h3>We connect</h3><p>Our network links suppliers, recyclers, processors and industrial buyers across India and overseas.</p></div>
        <div class="vcard reveal" data-delay="2"><span class="vcard__ico"><Icon name="truck" /></span><h3>We supply</h3><p>Recycled HDPE, PP, PPCP and LDPE granules and regrinds, delivered to manufacturers in India and for export.</p></div>
        <div class="vcard reveal" data-delay="3"><span class="vcard__ico"><Icon name="badge" /></span><h3>We verify</h3><p>Specifications and samples come with every offer, so suitability is confirmed by trial before you commit.</p></div>
      </div>
      <div class="center-cta reveal"><a class="btn btn--primary" href="/contact">Get in touch <Icon name="chevr" /></a></div>
    </div>
  </section>

  <section class="band">
    <div class="container band__inner reveal">
      <h2>Recycled material, matched to your product</h2>
      <p>Share the polymer, colour, quantity and delivery location. We come back with available material, specifications and price.</p>
      <a class="btn btn--dark" href="/contact#enquiry">Get started <Icon name="chevr" /></a>
      <ul class="band__points">
        <li>GST-registered business</li>
        <li>Domestic &amp; export supply</li>
        <li>Prices on enquiry</li>
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container split">
      <div class="reveal">
        <Media slot="G1" label="Container port — global trade" img="/images/global/port.jpg" alt="Container port with cranes and shipping containers" class="media--global" />
      </div>
      <div class="reveal" data-delay="1">
        <span class="eyebrow">Global polymer sourcing</span>
        <h2>Connecting global markets through reliable polymer sourcing</h2>
        <p class="lead">Beyond India, Akshita Recycle works as a global polymer sourcing company, linking international suppliers and buyers.</p>
        <ul class="hero-pills global-focus">
          <li>International imports</li>
          <li class="is-blue">Exports</li>
          <li>Sourcing</li>
          <li class="is-blue">Distribution</li>
        </ul>
        <div class="btn-row" style="margin-top:28px">
          <a class="btn btn--dark" href="/contact#enquiry">Discuss an import / export <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <h2 class="title-accent">Our product range</h2>
        <p class="lead">Recycled granules for extrusion, blow and injection moulding. Choose by polymer, process and colour. Specifications, samples and availability are confirmed with each offer.</p>
      </div>
      <div class="grid grid--3">
        {PRODUCTS.map((p, i) => <ProductCard product={p} delay={i % 3} />)}
        <a class="pcard pcard--feature reveal" data-delay="2" href="/products/plastic-regrinds">
          <div class="pcard__body">
            <span class="pcard__poly">REGRINDS</span>
            <h3>Plastic Regrinds</h3>
            <p>Unwashed, cold-washed and hot-washed HDPE, PPCP and ABS regrinds. Send the polymer, colour, washing requirement and quantity — availability is confirmed against your enquiry.</p>
            <span class="pcard__more">Enquire for availability <Icon name="arrow" /></span>
          </div>
        </a>
      </div>
      <div class="center-cta reveal"><a class="btn btn--primary" href="/products">View all products <Icon name="chevr" /></a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <h2 class="title-accent">Akshita Recycle: material you can rely on</h2>
      </div>
      <div class="values">
        <div class="values__media reveal">
          <Media slot="H2" label="About photo — material / warehouse / team" img="/images/site/home-about.jpg" />
        </div>
        <ol class="values__list">
          <li class="reveal"><span class="values__num">1</span><div><h3>Application-led selection</h3><p>We match material to your product, processing needs and budget, not the other way around. Tell us what you make and how you process it.</p></div></li>
          <li class="reveal" data-delay="1"><span class="values__num">2</span><div><h3>Clear colour options</h3><p>Natural, white, black and blue options across grades, confirmed with each offer so you know exactly what arrives.</p></div></li>
          <li class="reveal" data-delay="2"><span class="values__num">3</span><div><h3>Trial before you commit</h3><p>Specifications and sample arrangements are shared with the offer so you can run a production trial first.</p></div></li>
          <li class="reveal" data-delay="3"><span class="values__num">4</span><div><h3>Honest material information</h3><p>No inflated claims: no unverified PE100 or food-contact grades. Suitability is confirmed by trial.</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container split split--wide-text">
      <div class="reveal">
        <span class="eyebrow">Plastic regrinds</span>
        <h2>Looking for recycled plastic regrinds?</h2>
        <p class="lead">Send the polymer type, colour, washing requirement, quantity and intended use. Available material details and prices will be confirmed against your enquiry.</p>
        <div class="btn-row" style="margin-top:28px">
          <a class="btn btn--dark" href="/products/plastic-regrinds">See regrind range <Icon name="arrow" /></a>
          <a class="btn btn--outline" href={waLink('Hello Akshita Recycle, I would like to enquire about plastic regrinds.')} target="_blank" rel="noopener"><Icon name="wa" /> Ask on WhatsApp</a>
        </div>
      </div>
      <div class="regrind-list">
        {REGRINDS.map((r, i) => (
          <a class="regrind-item reveal" data-delay={i % 3} href={`/products/regrinds/${r.slug}`}>
            <span class="num">{r.slot}</span>
            <span><strong>{r.name}</strong><small>{r.source} · {r.washing}</small></span>
            <span class="arrow"><Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">How to enquire</span>
        <h2>From requirement to quotation in four simple steps</h2>
      </div>
      <ol class="process">
        <li class="process__step reveal">
          <span class="process__num" aria-hidden="true">1</span>
          <div class="process__body"><span class="process__label">Step 1</span><h3>Share your requirement</h3><p>Polymer, colour, quantity in kg or MT, application and delivery city / PIN code.</p></div>
        </li>
        <li class="process__step reveal" data-delay="1">
          <span class="process__num" aria-hidden="true">2</span>
          <div class="process__body"><span class="process__label">Step 2</span><h3>Material review</h3><p>We check available material against your product and processing needs.</p></div>
        </li>
        <li class="process__step reveal" data-delay="2">
          <span class="process__num" aria-hidden="true">3</span>
          <div class="process__body"><span class="process__label">Step 3</span><h3>Offer &amp; specifications</h3><p>Receive price, specifications, packaging and sample terms with the offer.</p></div>
        </li>
        <li class="process__step reveal" data-delay="3">
          <span class="process__num" aria-hidden="true">4</span>
          <div class="process__body"><span class="process__label">Step 4</span><h3>Trial &amp; supply</h3><p>Confirm suitability through a production trial, then plan your order.</p></div>
        </li>
      </ol>
    </div>
  </section>

  <section class="split-panel">
    <div class="split-panel__media">
      <Media slot="H3" label="Close-up of granules" img="/images/site/home-about-2.jpg" />
    </div>
    <div class="split-panel__body reveal">
      <h2>Built on sourcing.<br />Driven by partnerships.</h2>
      <p>Akshita Recycle is a polymer sourcing and material solutions company focused on sourcing, procurement and supply of recycled plastic materials.</p>
      <p>Our business covers multiple polymer categories, serving domestic and international markets with a commitment to transparency, consistency and long-term partnerships.</p>
      <a class="btn btn--light" href="/about">About us <Icon name="chevr" /></a>
    </div>
  </section>

  <CtaBand quoteHref={quoteLink()} />
</BaseLayout>
